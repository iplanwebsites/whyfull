{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": ["NODE_ENV"],
  "globalDependencies": ["packages/tsconfig/*.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    },
    "whyfull#build": {
      "dependsOn": ["@whyfull/viewer#build"],
      "outputs": ["dist/**"]
    },
    "@whyfull/brochure#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/EULA.md",
        "$TURBO_ROOT$/LICENSE",
        "$TURBO_ROOT$/PRIVACY.md",
        "$TURBO_ROOT$/TRADEMARKS.md"
      ]
    },
    "@whyfull/brochure#typecheck": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/EULA.md",
        "$TURBO_ROOT$/LICENSE",
        "$TURBO_ROOT$/PRIVACY.md",
        "$TURBO_ROOT$/TRADEMARKS.md"
      ]
    },
    "@whyfull/brochure#test": {
      "dependsOn": ["build", "whyfull#build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/EULA.md",
        "$TURBO_ROOT$/LICENSE",
        "$TURBO_ROOT$/PRIVACY.md",
        "$TURBO_ROOT$/TRADEMARKS.md"
      ]
    }
  }
}
