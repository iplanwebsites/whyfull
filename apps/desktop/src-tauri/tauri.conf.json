{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Whyfull",
  "version": "0.0.2",
  "identifier": "com.iplanwebsites.whyfull",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": [],
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "runtime/engine/": "runtime/engine/",
      "runtime/desktop.mjs": "runtime/desktop.mjs",
      "runtime/LICENSE": "runtime/LICENSE",
      "runtime/NOTICE": "runtime/NOTICE",
      "runtime/NODE-LICENSE": "runtime/NODE-LICENSE",
      "runtime/ENGINE-THIRD-PARTY.txt": "runtime/ENGINE-THIRD-PARTY.txt",
      "runtime/version.json": "runtime/version.json"
    },
    "category": "Utility",
    "shortDescription": "Find where your disk space went",
    "copyright": "Copyright Felix Menard",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "Entitlements.plist"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/whyfull-node"]
  }
}
