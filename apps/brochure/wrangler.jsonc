{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whyfull-brochure",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-19",
  "routes": [{ "pattern": "whyfull.app", "custom_domain": true }],
  "assets": {
    // Vite generates the complete brochure here; no SSR is needed.
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Keep the Worker in the request path, as in Slidepig. Future dynamic
    // routes can respond before falling back to the generated static files.
    "run_worker_first": true,
  },
}
