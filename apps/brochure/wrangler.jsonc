{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whyfull-brochure",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-19",
  "routes": [{ "pattern": "whyfull.app", "custom_domain": true }],
  "r2_buckets": [
    { "binding": "DOWNLOADS", "bucket_name": "whyfull-downloads" },
  ],
  // Issued licenses and recovery rate limits. See docs/commerce.md.
  "d1_databases": [
    {
      "binding": "LICENSES",
      "database_name": "whyfull-licenses",
      "database_id": "9d81bdde-7b34-45b6-8028-f40c88f72622",
      "migrations_dir": "migrations",
    },
  ],
  // Non-secret settings. Until STRIPE_PRICE_ID is set, /buy/ redirects to
  // /download/ as before. Also set, when ready:
  //   "STRIPE_PRICE_ID": "price_…"   the one-time $19 Price
  //   "EMAIL_FROM": "Whyfull <licenses@whyfull.app>"   a Resend-verified sender
  //   "SUPPORT_EMAIL": "support@whyfull.app"   reply-to and contact address
  // Secrets (never here; `wrangler secret put <NAME>`): STRIPE_SECRET_KEY,
  // STRIPE_WEBHOOK_SECRET, LICENSE_PRIVATE_KEY, RESEND_API_KEY.
  "vars": {
    "STRIPE_AUTOMATIC_TAX": "false",
    // Stripe Managed Payments (merchant of record). Turn on once activated
    // for the account; Stripe then handles tax and receipts.
    "STRIPE_MANAGED_PAYMENTS": "false",
  },
  // Staging: Stripe test mode on whyfull-brochure-staging.<account>.workers.dev.
  // It signs with its own key (.signing/whyfull-license-staging.pem), so a
  // test-card purchase never yields a key the real app accepts.
  // Deploy: pnpm deploy:staging. Stripe setup: pnpm stripe:setup --env staging
  "env": {
    "staging": {
      "name": "whyfull-brochure-staging",
      "workers_dev": true,
      "routes": [],
      "r2_buckets": [
        { "binding": "DOWNLOADS", "bucket_name": "whyfull-downloads" },
      ],
      "d1_databases": [
        {
          "binding": "LICENSES",
          "database_name": "whyfull-licenses-staging",
          "database_id": "a7a180b0-dd6e-46b4-8221-78c8ec237409",
          "migrations_dir": "migrations",
        },
      ],
      "vars": {
        "STRIPE_AUTOMATIC_TAX": "false",
        "STRIPE_MANAGED_PAYMENTS": "false",
        "LICENSE_PUBLIC_KEY": "MCowBQYDK2VwAyEAKQ9gtBg3YzbcTBq4Cq+4S/nB48s08yinko6/dIl1AK4=",
      },
    },
  },
  "assets": {
    // Vite generates the complete brochure here; no SSR is needed.
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Keep the Worker in the request path, as in Slidepig. Future dynamic
    // routes can respond before falling back to the generated static files.
    "run_worker_first": true,
  },
}
