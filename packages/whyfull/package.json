{
  "name": "whyfull",
  "version": "0.0.1",
  "private": false,
  "description": "Report where disk space went on a developer machine — AI model caches, package stores, build output. Read-only, zero dependencies.",
  "keywords": [
    "disk",
    "disk-space",
    "cache",
    "cleanup",
    "huggingface",
    "ollama",
    "lmstudio",
    "docker",
    "node_modules",
    "devtools"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "yful": "./dist/cli.mjs"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18.15"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.mjs\"",
    "dev": "tsdown --watch",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@yful/tsconfig": "workspace:*",
    "scriptc": "^0.0.23",
    "tsdown": "^0.22.14",
    "typescript": "^5.7.2",
    "unrun": "^0.3.1"
  }
}
