{
  "name": "whyfull",
  "version": "0.0.3",
  "private": false,
  "description": "Find where disk space went on a dev machine: AI models (Hugging Face, Ollama, LM Studio), caches, package stores, Docker, build output and agent worktrees, ranked by how safe each is to delete. Free CLI with JSON reports for coding agents, a local browser explorer and demo-first macOS Trash cleanup. Source available.",
  "author": "Felix Menard",
  "homepage": "https://github.com/iplanwebsites/whyfull#readme",
  "bugs": {
    "url": "https://github.com/iplanwebsites/whyfull/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iplanwebsites/whyfull.git",
    "directory": "packages/whyfull"
  },
  "keywords": [
    "disk",
    "disk-space",
    "cache",
    "cleanup",
    "huggingface",
    "ollama",
    "lmstudio",
    "docker",
    "node_modules",
    "devtools",
    "disk-usage",
    "ai-models",
    "git-worktree",
    "cli"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "bin": {
    "whyfull": "dist/cli.mjs"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs/viewer.md",
    "docs/personalization.md",
    "LICENSE",
    "NOTICE",
    "EULA.md",
    "PRIVACY.md",
    "TRADEMARKS.md"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && node scripts/build-viewer.mjs && node scripts/build-native.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.mjs\"",
    "dev": "tsdown --watch",
    "prepack": "node ../../scripts/sync-publish-docs.mjs && pnpm exec turbo build --filter=whyfull && node ../../scripts/check-signing-material.mjs --package",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@clack/prompts": "1.0.0",
    "@streamparser/json": "^0.0.26",
    "mri": "^1.2.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@whyfull/tsconfig": "workspace:*",
    "echarts": "^6.1.0",
    "esbuild": "^0.28.2",
    "tsdown": "^0.22.14",
    "typescript": "^5.7.2"
  }
}
